LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Relative endpoint paths; do not include /v1 here.
LLM_COMPLETIONS_PATH=/chat/completions
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=1536
EMBEDDING_PATH=/embeddings
# Optional provider used by per-knowledge-base profiles.
LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_EMBEDDING_API_KEY=
LOCAL_EMBEDDING_PATH=/embeddings
MCP_TIMEOUT_MS=8000
MCP_ALLOW_PRIVATE_NETWORK=true
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/intra_copilot
DATABASE_USERNAME=intra
DATABASE_PASSWORD=intra
RAG_TOP_K=5
RAG_CHUNK_SIZE=1200
RAG_MAX_DOCUMENT_BYTES=10485760
AGENT_LLM_TIMEOUT_SECONDS=180
AGENT_SSE_TIMEOUT_SECONDS=600
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
CORS_ALLOWED_ORIGINS=chrome-extension://*,http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional. When omitted, sessions are invalidated whenever the backend restarts.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MINUTES=480
