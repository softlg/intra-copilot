LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Relative endpoint paths; do not include /v1 here.
LLM_COMPLETIONS_PATH=/chat/completions
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=1536
EMBEDDING_PATH=/embeddings
# Optional provider used by per-knowledge-base profiles.
LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_EMBEDDING_API_KEY=
LOCAL_EMBEDDING_PATH=/embeddings
MCP_TIMEOUT_MS=8000
MCP_ALLOW_PRIVATE_NETWORK=false
MCP_ALLOW_STDIO=false
MCP_STDIO_ALLOWED_COMMANDS=
MCP_STDIO_WORKING_DIRECTORY=
TOOLS_ALLOW_HTTP=false
TOOLS_ALLOW_PRIVATE_NETWORK=false
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/intra_copilot
DATABASE_USERNAME=intra
DATABASE_PASSWORD=intra
RAG_TOP_K=5
RAG_CHUNK_SIZE=1200
RAG_SEARCH_CONCURRENCY=4
RAG_MAX_DOCUMENT_BYTES=10485760
AGENT_LLM_TIMEOUT_SECONDS=180
AGENT_SSE_TIMEOUT_SECONDS=600
BROWSER_SELENIUM_ENABLED=true
BROWSER_SELENIUM_HEADLESS=true
BROWSER_SELENIUM_TIMEOUT_SECONDS=30
# Optional paths; Selenium Manager detects Chrome/ChromeDriver when blank.
BROWSER_SELENIUM_DRIVER_PATH=
BROWSER_SELENIUM_BINARY_PATH=
BROWSER_RUNTIME_PRESENCE_TTL_SECONDS=75
BROWSER_RUNTIME_LEASE_SECONDS=45
BROWSER_RUNTIME_COMMAND_TIMEOUT_SECONDS=120
BROWSER_RUNTIME_MAINTENANCE_INTERVAL_MS=30000
BROWSER_RUNTIME_RECOVERY_INTERVAL_MS=15000
BROWSER_RUNTIME_WORKER_THREADS=4
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1
LOG_ANSI_ENABLED=DETECT
# Unique node number (0-31) per backend instance; omit to derive it from host and process.
APP_NODE_ID=
CORS_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:4174,http://127.0.0.1:4174
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-value
ADMIN_SESSION_TTL_MINUTES=480
SECURITY_REQUIRE_SECURE_ADMIN_CONFIG=true
STREAM_CORE_THREADS=4
STREAM_MAX_THREADS=16
STREAM_QUEUE_CAPACITY=200
OPENAPI_ENABLED=false
TRACE_WRITE_FLUSH_MS=500
STORAGE_DELETE_POLL_MS=5000
