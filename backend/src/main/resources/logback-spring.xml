<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <conversionRule
      conversionWord="levelColor"
      converterClass="com.intra.copilot.infrastructure.logging.LevelColorConverter"/>

  <springProperty
      scope="context"
      name="CONSOLE_LOG_PATTERN"
      source="logging.pattern.console"
      defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS} %levelColor(%-5level) [%thread] [trace=%X{traceId:-} turn=%X{turnId:-} span=%X{spanId:-} request=%X{requestId:-}] %logger{36} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${CONSOLE_LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
